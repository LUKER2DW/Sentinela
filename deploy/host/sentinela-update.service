[Unit]
Description=Sentinela automatic update from the latest release (ADR-0023)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# The timer passes --scheduled (only in the chosen hour, when turned on);
# sentinela-update-request.service passes --request.
ExecStart=/opt/sentinela/scripts/auto-update.sh --scheduled
Nice=10
IOSchedulingClass=idle
