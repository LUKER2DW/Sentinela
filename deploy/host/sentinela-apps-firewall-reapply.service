# Started by sentinela-apps-firewall.path when the public ports change (or
# when the agent asks for the firewall again). The script serializes runs.
[Unit]
Description=Re-apply the Sentinela self-hosted services firewall
After=docker.service sentinela-apps-firewall.service

[Service]
Type=oneshot
ExecStart=/opt/sentinela/scripts/apps-firewall.sh apply
