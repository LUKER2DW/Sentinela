# /etc/sentinela/secrets.env — chmod 600, owner root. Created by
# scripts/install-server.sh. Read by go2rtc, recorder and sentinela.
# One USER/PASS pair per camera, named by user_env/password_env in config.yaml.
# Written for you when you add a camera in the browser (or with
# scripts/add-camera.sh). XMEye: no & ? / # % or spaces. Other cameras:
# no : @ / ? # % or spaces.
FRONT_USER=admin
FRONT_PASS=change-me
