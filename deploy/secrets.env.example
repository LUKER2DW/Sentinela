# /etc/sentinela/secrets.env — chmod 600, owner root. Created by
# scripts/install-server.sh. Read by go2rtc, recorder and sentinela.
# The camera parses these literally from the RTSP path: no & ? / # % or spaces.
CAM1_USER=admin
CAM1_PASS=change-me
# Remote access trial P2 (ADR-0019): Tailscale OAuth client with the
# auth_keys scope for tag:sentinela-app. Leave empty to disable app keys.
# TS_OAUTH_CLIENT_ID=
# TS_OAUTH_CLIENT_SECRET=
