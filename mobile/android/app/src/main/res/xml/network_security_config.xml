<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the embedded tailnet node's local proxy on
     127.0.0.1 (ADR-0019 P2): that hop never leaves the phone, and the proxy
     speaks HTTPS to the server over the tailnet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
