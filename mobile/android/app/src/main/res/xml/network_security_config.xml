<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere. The old exception for the embedded tailnet node's local
     proxy on 127.0.0.1 (ADR-0019 P2) was removed with that node: nothing in the
     app talks to a cleartext address any more. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
